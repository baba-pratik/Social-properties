	"functions": [
		{
			"arguments": "",
			"definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\nAS $function$\nBEGIN\n    INSERT INTO public.profiles (id, full_name, avatar_url, phone, role)\n    VALUES (\n        NEW.id,\n        COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.raw_user_meta_data->>'name', 'New Member'),\n        COALESCE(NEW.raw_user_meta_data->>'avatar_url', NEW.raw_user_meta_data->>'picture'),\n        NEW.phone,\n        COALESCE((NEW.raw_user_meta_data->>'role')::public.user_role, 'buyer'::public.user_role)\n    );\n    RETURN NEW;\nEND;\n$function$\n",
			"return_type": "trigger",
			"function_name": "handle_new_user"
		}
	],
